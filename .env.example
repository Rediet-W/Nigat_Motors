# Optional: override the live domain used for canonical / Open Graph / sitemap URLs.
# NEXT_PUBLIC_SITE_URL=https://nigat-motors.vercel.app

# Enquiry form delivery: configure at least one channel.
# Telegram group (create a bot with @BotFather, add it to the sales group):
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Email via Resend (https://resend.com):
# RESEND_API_KEY=
# ENQUIRY_TO_EMAIL=sales@example.com
# ENQUIRY_FROM_EMAIL=Website <website@your-domain>
# Any form service / webhook receiving JSON:
# ENQUIRY_WEBHOOK_URL=
